{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"title": "Nordic",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#f8f9fb"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#1c2b3a"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#5b8fa8"
				},
				{
					"name": "Accent Light",
					"slug": "accent-light",
					"color": "#ddeaf0"
				},
				{
					"name": "Subtle",
					"slug": "subtle",
					"color": "#eaeff3"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#566976"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			}
		}
	}
}
