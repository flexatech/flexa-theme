{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Primary",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#ffffff"
				},
				{
					"name": "Contrast",
					"slug": "contrast",
					"color": "#1a1a2e"
				},
				{
					"name": "Primary",
					"slug": "primary",
					"color": "#c0392b"
				},
				{
					"name": "Secondary",
					"slug": "secondary",
					"color": "#9e2f23"
				},
				{
					"name": "Neutral",
					"slug": "neutral",
					"color": "#f4f4f6"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#c0392b"
				},
				{
					"name": "Accent Light",
					"slug": "accent-light",
					"color": "#fadbd8"
				},
				{
					"name": "Subtle",
					"slug": "subtle",
					"color": "#f4f4f6"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#6c6c80"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			}
		}
	}
}
